{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "IncuBrix operation result",
	"oneOf": [
		{
			"type": "object",
			"required": ["type", "current_start_s", "current_end_s", "duration_before_s", "duration_after_s"],
			"properties": {
				"type": { "const": "cut" },
				"current_start_s": { "type": "number", "minimum": 0 },
				"current_end_s": { "type": "number", "exclusiveMinimum": 0 },
				"duration_before_s": { "type": "number", "exclusiveMinimum": 0 },
				"duration_after_s": { "type": "number", "exclusiveMinimum": 0 }
			},
			"additionalProperties": false
		},
		{
			"type": "object",
			"required": ["type", "current_start_s", "current_end_s", "speed", "duration_before_s", "duration_after_s"],
			"properties": {
				"type": { "const": "speed" },
				"current_start_s": { "type": "number", "minimum": 0 },
				"current_end_s": { "type": "number", "exclusiveMinimum": 0 },
				"speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
				"duration_before_s": { "type": "number", "exclusiveMinimum": 0 },
				"duration_after_s": { "type": "number", "exclusiveMinimum": 0 }
			},
			"additionalProperties": false
		},
		{
			"type": "object",
			"required": ["type", "caption_id", "text", "anchor_word_ids", "source_interval_s"],
			"properties": {
				"type": { "const": "add_caption" },
				"caption_id": { "type": "string", "minLength": 1 },
				"text": { "type": "string", "minLength": 1 },
				"anchor_word_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
				"source_interval_s": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }], "minItems": 2, "maxItems": 2 }
			},
			"additionalProperties": false
		}
	]
}
